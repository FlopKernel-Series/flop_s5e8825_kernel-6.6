# Samsung SoC drivers
#
#
config VENDOR_NR_CPUS
	int "Maximum number of CPUs (2-4096) governed by vendor"
	range 2 4096
	default "2"

config SCHED_EMS
	tristate "Exynos Mobile Scheduler"
	depends on SMP
	default n
	help
	  This option supports Exynos mobile scheduler.

config SCHED_EMS_TUNE
	bool "Tuner for Exynos Mobile Scheduler"
	depends on SCHED_EMS
	default n
	help
	  This option supports tuner for Exynos mobile scheduler.

config CPU_IDLE_GOV_HALO
        bool "Halo CPU IDLE Governor"
        depends on SCHED_EMS
        default n
        help
          This option supports idle selection for Exynos Mobile scheduler.

