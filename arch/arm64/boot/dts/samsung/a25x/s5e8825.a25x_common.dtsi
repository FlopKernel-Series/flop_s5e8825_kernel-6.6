#include "../s5e8825.common.dtsi"
#include "../s5e8825-dsim_pll_timing.dtsi"
#include "../s5e8825_wakeup_cpu_allocator.dtsi"

#define BOARD_ID        0x0
#define BOARD_REV       0x0

/ {
	compatible = "samsung,s5e8825", "samsung,SMDK8825";
	board_id = <BOARD_ID>;
	board_rev = <BOARD_REV>;

	fragment@model {
		target-path = "/";
		__overlay__ {
			#address-cells = <2>;
			#size-cells = <1>;

			sec_usb_cb {
				compatible = "samsung,sec_usb_cb";
				status = "okay";
			};

			sec_usb_hook {
				compatible = "samsung,sec_usb_hook";
				status = "okay";
			};

			dummy_audio_codec: audio-codec-dummy {
				compatible = "snd-soc-dummy";
				#sound-dai-cells = <0>;
			};

			dummy_audio_cpu: audio-cpu-dummy {
				compatible = "samsung,dummy-cpu";
				#sound-dai-cells = <0>;
			};

			abox_synchronized_ipc: abox_synchronized_ipc {
				compatible = "samsung,abox-synchronized-ipc";
				#sound-dai-cells = <1>;
				abox = <&abox>;
			};

			sec-audio-exynos {
				compatible = "samsung,audio-exynos";
				abox_dbg_size_min = <0x600000>;
				abox_slog_size_min = <0x0>;
				status = "okay";
			};

			sec-audio-sysfs {
				compatible = "samsung,audio-sysfs";
				status = "okay";
				/* audio,no-earjack; */
				audio,num-amp = <2>;
			};

			sec-audio-debug {
				compatible = "samsung,audio-debug";
				status = "okay";
			};

			snd-debug-proc {
				compatible = "samsung,snd-debug-proc";
				status = "okay";
			};

			sound {
				compatible = "samsung,exynos8825-rt5665";

				samsung,routing =
					"HEADSETMIC", "MICBIAS1",
					"DMIC1", "MICBIAS2",
					"DMIC2", "MICBIAS3",
					"IN1P", "HEADSETMIC",
					"IN1N", "HEADSETMIC",
					"IN3P", "DMIC1",
					"IN3N", "DMIC1",
					"IN4P", "DMIC2",
					"IN4N", "DMIC2",
					"HEADPHONE", "HPOL",
					"HEADPHONE", "HPOR",
					"BLUETOOTH SPK", "ABOX UAIF3 Playback",
					"ABOX UAIF3 Capture", "BLUETOOTH MIC",
					"USB SPK", "ABOX USB Playback",
					"ABOX USB Capture", "USB MIC",
					"FWD SPK", "ABOX FWD Playback",
					"ABOX FWD Capture", "FWD MIC",
					"VTS Virtual Output", "VTS Virtual Output Mux",
					"ABOX SPDY Capture", "VINPUT_FM";

				samsung,aux = <&abox_effect &abox_tplg>;

				rdma0 {
					cpu {
						sound-dai = <&abox_rdma_0 0>;
					};
					platform {
						sound-dai = <&abox_rdma_0 0>;
					};
				};
				rdma1 {
					cpu {
						sound-dai = <&abox_rdma_1 0>;
					};
					platform {
						sound-dai = <&abox_rdma_1 0>;
					};
				};
				rdma2 {
					cpu {
						sound-dai = <&abox_rdma_2 0>;
					};
					platform {
						sound-dai = <&abox_rdma_2 0>;
					};
				};
				rdma3 {
					cpu {
						sound-dai = <&abox_rdma_3 0>;
					};
					platform {
						sound-dai = <&abox_rdma_3 0>;
					};
				};
				rdma4 {
					cpu {
						sound-dai = <&abox_rdma_4 0>;
					};
					platform {
						sound-dai = <&abox_rdma_4 0>;
					};
				};
				rdma5 {
					cpu {
						sound-dai = <&abox_rdma_5 0>;
					};
					platform {
						sound-dai = <&abox_rdma_5 0>;
					};
				};
				rdma6 {
					cpu {
						sound-dai = <&abox_rdma_6 0>;
					};
					platform {
						sound-dai = <&abox_rdma_6 0>;
					};
				};
				rdma7 {
					cpu {
						sound-dai = <&abox_rdma_7 0>;
					};
					platform {
						sound-dai = <&abox_rdma_7 0>;
					};
				};
				rdma8 {
					cpu {
						sound-dai = <&abox_rdma_8 0>;
					};
					platform {
						sound-dai = <&abox_rdma_8 0>;
					};
