&abox_uaif_2 {
	pinctrl-names;
};

&abox_uaif_3 {
	pinctrl-names;
};

&pinctrl_6 {
	amp_en: amp-en {
		samsung,pins ="gpg2-1";
		samsung,pin-function = <1>;
		samsung,pin-val = <1>;
		samsung,pin-pud = <0>;
		samsung,pin-con-pdn = <3>;
		samsung,pin-pud-pdn = <0>;
	};
};

&pinctrl_4 {
	rcv_amp_int: rcv-amp-int {
		samsung,pins ="gpf1-5";
		samsung,pin-function = <0xf>;
		samsung,pin-pud = <0>;
		samsung,pin-pud-pdn = <0>;
	};

	spk_amp_int: spk-amp-int {
		samsung,pins ="gpf1-6";
		samsung,pin-function = <0xf>;
		samsung,pin-pud = <0>;
		samsung,pin-pud-pdn = <0>;
	};
};

&hsi2c_7 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	clock-frequency = <400000>;

	tfa98xx_bottom: tfa98xx@34 {
		#sound-dai-cells = <1>;
		compatible = "tfa,tfa98xx";
		reg = <0x34>;

		pinctrl-names = "default";
		pinctrl-0 = <&amp_en &spk_amp_int>;

		reset-gpio = <&gpg2 1 0>;
		irq-gpio = <&gpf1 6 0>;

		dummy-cal = <5800>;
	};

	tfa98xx_top: tfa98xx@35 {
		#sound-dai-cells = <1>;
		compatible = "tfa,tfa98xx";
		reg = <0x35>;

		pinctrl-names = "default";
		pinctrl-0 = <&rcv_amp_int>;

		irq-gpio = <&gpf1 5 0>;

		dummy-cal = <6200>;
	};
};

&pinctrl_0 {
	codec_irq: codec-irq {
		samsung,pins = "gpc2-0";
		samsung,pin-function = <0xf>;
		samsung,pin-pud = <0>;
		samsung,pin-pud-pdn = <0>;
	};
};

&pinctrl_6 {
	codec_i2c: codec-i2c {
		samsung,pins = "gpp3-0", "gpp3-1";
		samsung,pin-function = <2>;
		samsung,pin-pud = <3>;
		samsung,pin-drv = <0>;
		samsung,pin-pud-pdn = <3>;
		samsung,pin-con-pdn = <3>;
	};
};

&hsi2c_12 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&codec_i2c>;

	rt5665: rt5665@1b {
		#sound-dai-cells = <1>;

		compatible = "realtek,rt5665";
		reg = <0x1b>;

		pinctrl-names = "default";
		pinctrl-0 = <&codec_irq>;
		interrupt-parent = <&gpc2>;
		interrupts = <0 0 0>;

		realtek,in1-differential;
		realtek,in3-differential;
		realtek,in4-differential;
		realtek,jd-src = <2>;
		realtek,mic-check-in-bg;
		realtek,dmic2-data-pin =<2>;
		realtek,sar-hs-type = <700>;
		realtek,sar-pb-vth0 = <95>;
		realtek,sar-pb-vth1 = <139>;
		realtek,sar-pb-vth2 = <246>;
		realtek,sar-pb-vth3 = <580>;
		imp_table = <
			/*min max gain bias*/
			0x0000 0x000d 3 6 // 8 ohm
			0x000e 0x0019 1 6 // 16 ohm
			0x001a 0x0035 0 6 // 32 ohm
			0x0036 0x0067 0 6 // 64 ohm
			0x0068 0xffff 0 6 // > 100 ohm
		>;

		realtek,offset-comp = <0x0078 0x0090 0x00b0 0x00c0
					0x00f0 0x0110 0x0130 0x0180
					0x01e0 0x0200 0x02a0 0x0300
					0x03a0 0x0400 0x0500 0x0600>;
		realtek,offset-comp-r = <0x001a 0x001f 0x0020 0x002a
					0x0030 0x0040 0x0050 0x0060
					0x006f 0x007f 0x00a0 0x00b0
					0x00cf 0x0100 0x0120 0x0160>;

		regulator_1v8-supply = <&l22_reg>;
		regulator_3v3-supply = <&s_l27_reg>;
	};
};

&pinctrl_6 {
	fm-lna-en {
		samsung,pins = "gpp3-5";
		samsung,pin-function = <1>;
		samsung,pin-pud = <0>;
		samsung,pin-con-pdn = <0>;
	};
};

&drmdecon0{
		/* S6E3FC3 mdnie multi cmd make 2A/2B cmd mismatch. */
		partial-update = <0>;
};

&drmdsim_0 {
	#address-cells = <1>;
	#size-cells = <0>;

	hs_pll_timing = <&dsim_hs_pll_timing>;

	drmpanel0: drmpanel {
		compatible = "samsung,mcd-panel-samsung-drv";
		/* reset, power */
		reset-gpios = <&gpc7 0 GPIO_ACTIVE_HIGH>;
		reg = <0>;
	};
};

&dwmmc_2 {
	card-detect-invert;
	sec-sd-slot-type = <3>;
};
