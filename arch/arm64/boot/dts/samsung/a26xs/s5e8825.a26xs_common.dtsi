&abox_uaif_0 {
	pinctrl-names;
	pinctrl-0;
	pinctrl-1;
};

&abox_uaif_2 {
	pinctrl-names;
};

&abox_uaif_3 {
	pinctrl-names;
};

&vts {
	pinctrl-names = "dmic0_default",
		"dmic1_default",
		"dmic2_default",
		"amic0_default",
		"amic1_default",
		"amic2_default",
		"dmic0_idle",
		"dmic1_idle",
		"dmic2_idle",
		"default";
	pinctrl-0 = <&dmic_bus_clk0 &dmic_pdm0_bus &dmic_en>;
	pinctrl-1 = <&dmic_bus_clk2 &dmic_pdm2_bus &dmic_en>;
	pinctrl-2 = <&dmic_bus_clk2 &dmic_pdm2_bus>;
	pinctrl-3 = <&dmic_bus_clk0 &amic_pdm0_bus>;
	pinctrl-4 = <&dmic_bus_clk1 &amic_pdm1_bus>;
	pinctrl-5 = <&dmic_bus_clk2 &amic_pdm2_bus>;
	pinctrl-6 = <&dmic_bus_clk0_idle &dmic_pdm0_idle &dmic_en_idle>;
	pinctrl-7 = <&dmic_bus_clk2_idle &dmic_pdm2_idle &dmic_en_idle>;
	pinctrl-8 = <&dmic_bus_clk2_idle &dmic_pdm2_idle>;
	pinctrl-9 = <>;
};

&pinctrl_6 {
	spk_amp_en: spk-amp-en {
		samsung,pins ="gpg2-1";
		samsung,pin-function = <1>;
		samsung,pin-val = <1>;
		samsung,pin-pud = <0>;
		samsung,pin-con-pdn = <3>;
		samsung,pin-pud-pdn = <0>;
	};

	hsi2c12_amp_bus: hsi2c12-amp-bus {
		samsung,pins = "gpp3-0", "gpp3-1";
		samsung,pin-function = <2>;
		samsung,pin-pud = <3>;
		samsung,pin-drv = <0>;
		samsung,pin-con-pdn = <3>;
		samsung,pin-pud-pdn = <3>;
	};

	dmic_en: dmic-en {
		samsung,pins = "gpp3-5";
		samsung,pin-function = <1>;
		samsung,pin-pud = <0>;
		samsung,pin-val = <1>;
	};

	dmic_en_idle: dmic-en-idle {
		samsung,pins = "gpp3-5";
		samsung,pin-function = <1>;
		samsung,pin-pud = <0>;
		samsung,pin-val = <0>;
	};
};

&pinctrl_4 {
	rcv_amp_int: rcv-amp-int {
		samsung,pins ="gpf1-5";
		samsung,pin-function = <0xf>;
		samsung,pin-pud = <0>;
		samsung,pin-con-pdn = <3>;
		samsung,pin-pud-pdn = <0>;
	};

	spk_amp_int: spk-amp-int {
		samsung,pins ="gpf1-6";
		samsung,pin-function = <0xf>;
		samsung,pin-pud = <3>;
		samsung,pin-con-pdn = <3>;
		samsung,pin-pud-pdn = <3>;
	};
};

&hsi2c_7 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	clock-frequency = <400000>;

	aw882xx_amp: aw882xx_smartpa@34 {
		compatible = "awinic,aw882xx_smartpa";
		#sound-dai-cells = <1>;
		reg = <0x34>;
		pinctrl-names = "default";
		pinctrl-0 = <&spk_amp_en &spk_amp_int>;
		reset-gpio = <&gpg2 1 0>;
		irq-gpio = <&gpf1 6 0>;
		rename-flag = <1>;
		sound-channel = <0>;
		num-amp = <1>;
		sync-load = <1>;
		sync-flag = <0>;
		aw-cali-mode = "aw_cali_all";
		status = "okay";
	};
};

&hsi2c_12 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	clock-frequency = <400000>;
	pinctrl-0 = <&hsi2c12_amp_bus>;

	fs1816_amp: fs1816@34 {
		compatible = "foursemi,fs1816";
		#sound-dai-cells = <1>;
		reg = <0x34>;
		pinctrl-names = "default";
		pinctrl-0 = <&rcv_amp_int>;
		intz-gpios = <&gpf1 5 0>;
		fs,rx_channel = <3>; /* MonoMix */
		fs,rx_volume = <991>;
		status = "okay";
	};
};

/* VIDEO MODE dt overlay START */
&drmdecon0{
		/* 0: video mode, 1: MIPI command mode 2: DP command mode */
		op_mode = <0>;
		partial-update = <0>;
		hibernation = <0>;
		samsung,iommu-identity-map = <0x0 0xFA100000  0x01400000>;
};

&reserved_memory{
	fb_handover: bootloader_fb {
		compatible = "exynos,fb_handover";
		reg = <0x0 0xFA200000 0x009E4000>; /* 1080 * 2400 * 4 =  0x009EBB00 */
	};
};

&drmdsim_0 {
	#address-cells = <1>;
	#size-cells = <0>;

	hs_pll_timing = <&dsim_hs_pll_timing>;

	/* Required only for video mode */
	memory-region = <&fb_handover>;

	drmpanel0: drmpanel {
		compatible = "samsung,mcd-panel-samsung-drv";
		/* reset, power */
		reset-gpios = <&gpc7 0 GPIO_ACTIVE_HIGH>;
		reg = <0>;
	};
};
/* VIDEO MODE dt overlay END */

&dwmmc_2 {
	card-detect-invert;
	sec-sd-slot-type = <3>;
};