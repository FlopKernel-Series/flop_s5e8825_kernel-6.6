&abox {
	ext_bin_0: ext-bin@0 {
		compatible = "samsung,abox-ext-bin";
		samsung,name = "dax_param.bin";
		samsung,area = <1>;
		samsung,offset = <0x510000>;
		samsung,changable;
	};

	ext_bin_1: ext-bin@1 {
		compatible = "samsung,abox-ext-bin";
		samsung,name = "AP_AUDIO_SLSI.bin";
		samsung,area = <1>;
		samsung,offset = <0x52e000>;
		samsung,changable;
	};

	ext_bin_2: ext-bin@2 {
		compatible = "samsung,abox-ext-bin";
		samsung,name = "APBargeIn_AUDIO_SLSI.bin";
		samsung,area = <1>;
		samsung,offset = <0x5da800>;
		samsung,changable;
	};

	ext_bin_3: ext-bin@3 {
		compatible = "samsung,abox-ext-bin";
		samsung,name = "APBiBF_AUDIO_SLSI.bin";
		samsung,area = <1>;
		samsung,offset = <0x5dd800>;
		samsung,changable;
	};

	ext_bin_4: ext-bin@4 {
		compatible = "samsung,abox-ext-bin";
		samsung,name = "APDV_AUDIO_SLSI.bin";
		samsung,area = <1>;
		samsung,offset = <0x5de800>;
		samsung,changable;
	};

	ext_bin_5: ext-bin@5 {
		compatible = "samsung,abox-ext-bin";
		samsung,name = "SoundBoosterParam.bin";
		samsung,area = <1>;
		samsung,offset = <0x65e800>;
		samsung,changable;
	};

	ext_bin_6: ext-bin@6 {
		compatible = "samsung,abox-ext-bin";
		samsung,name = "spkamp_param_aw882xx.bin";
		samsung,area = <1>;
		samsung,offset = <0x664800>;
		samsung,changable;
	};

	ext_bin_7: ext-bin@7 {
		compatible = "samsung,abox-ext-bin";
		samsung,name = "rxse.bin";
		samsung,area = <1>;
		samsung,offset = <0x6c5000>;
	};

	ext_bin_8: ext-bin@8 {
		compatible = "samsung,abox-ext-bin";
		samsung,name = "avsyncmix.bin";
		samsung,area = <1>;
		samsung,offset = <0x7b7800>;
	};

	ext_bin_9: ext-bin@9 {
		compatible = "samsung,abox-ext-bin";
		samsung,name = "txse1.bin";
		samsung,area = <1>;
