			0x15 0x44 /* 0x90~0x91 */

			/* battery,soc_arr_val */
			11611 11038 10464 9890 9317 8743 8169 7595 7022 6448
			5874 5301 4727 4153 3579 3006 2432 1858 1285 711
			137 (-131)

			/* battery,ocv_arr_val */
			44666 44105 43544 42971 42357 41748 41164 40620 40118 39625
			39011 38646 38375 38156 37979 37815 37564 37342 36998 36876
			35196 31613

			/* battery,rRS_CC0 */
			0x17 /* [0x5C] */
			>;
	};
};

