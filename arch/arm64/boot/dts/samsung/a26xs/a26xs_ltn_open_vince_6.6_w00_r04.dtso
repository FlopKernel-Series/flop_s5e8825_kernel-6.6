			threshold_time = <1200>, <1200>, <1200>, <0>, <0>, <5>;
#else
			threshold_cnt = <20>, <2>, <20>, <1>, <1>, <25>;
			threshold_time = <1200>, <1200>, <1200>, <0>, <0>, <5>;
#endif
		};
	};
};

