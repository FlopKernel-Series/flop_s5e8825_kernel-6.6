/* 
 * #define PIN_AP_FUNC_INPUT		0x0
 * #define PIN_AP_FUNC_OUTPUT		0x1
 * #define PIN_AP_FUNC_OUTPUT_HIGH	0x1
 * #define PIN_AP_FUNC_OUTPUT_LOW	0x1
 * #define PIN_AP_FUNC_INPUT_WAKEUP	0xf

 * arch/arm64/boot/dts/samsung/exynos_gpio_config_macros.dtsi
 * #define PIN_PDN_OUT0		0
 * #define PIN_PDN_OUT1		1
 * #define PIN_PDN_INPUT	2
 * #define PIN_PDN_PREV		3
 */

#ifndef PIN_PDN_PREV
#define PIN_PDN_PREV	3
#endif

&pinctrl_0 {
	nfc_rst: nfc_rst {
		samsung,pins = SEC_GPIO(AP,gpc4,gpc4,0);
		samsung,pin-function = <PIN_AP_FUNC_OUTPUT>;
		samsung,pin-pud = <PIN_PULL_NONE>;
		samsung,pin-val = <0>;
		samsung,pin-con-pdn = <PIN_PDN_PREV>;
		samsung,pin-pud-pdn = <PIN_PULL_NONE>;
	};
	nfc_rst_nc: nfc_rst_nc {
		samsung,pins = SEC_GPIO(AP,gpc4,gpc4,0);
		samsung,pin-function = <PIN_AP_FUNC_INPUT>;
		samsung,pin-pud = <PIN_PULL_DOWN>;
		samsung,pin-con-pdn = <PIN_PDN_PREV>;
		samsung,pin-pud-pdn = <PIN_PULL_DOWN>;
	};
};
&pinctrl_0 {
	nfc_clk_req: nfc_clk_req {
		samsung,pins = SEC_GPIO(AP,gpa1,gpa1,1);
		samsung,pin-function = <2>;
		samsung,pin-pud = <PIN_PULL_NONE>;
	};
	nfc_clk_req_nc: nfc_clk_req_nc {
		samsung,pins = SEC_GPIO(AP,gpa1,gpa1,1);
		samsung,pin-function = <PIN_AP_FUNC_INPUT>;
		samsung,pin-pud = <PIN_PULL_DOWN>;
	};
};

&pinctrl_0 {
	nfc_irq: nfc_irq {
		samsung,pins = SEC_GPIO(AP,gpa1,gpa1,2);
		samsung,pin-function = <PIN_AP_FUNC_INPUT>;
		samsung,pin-pud = <PIN_PULL_DOWN>;
	};
	nfc_irq_nc: nfc_irq_nc {
		samsung,pins = SEC_GPIO(AP,gpa1,gpa1,2);
		samsung,pin-function = <PIN_AP_FUNC_INPUT>;
		samsung,pin-pud = <PIN_PULL_DOWN>;
	};
};

#if 1
