/* #include "../pmic_S2MPU14.dtsi" */                /* From pmic_S2MPU14.py */
&acpm_mfd_bus1 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	s2mpu14mfd@1f {
		compatible = "samsung,s2mpu14mfd";
		acpm-ipc-channel = <2>;
		s2mpu14,wakeup = "enabled";
		reg = <0x2f>;
		wtsr_en = <1>; /* 1 : enable , 0 : disable */

		/* SEL_VGPIO0S~18S (CONTROL_SEL#) */
		sel_vgpio = <0x0A 0x68 0xB1 0x33 0x03 0x68 0xA1 0x21 0x73 0x33
			     0x53 0x56 0xC5 0x7C 0x77 0x33 0x33 0x33 0x03>;

		s2mpu14_gpio: s2mpu14-gpio {
			gpio-controller;
			#gpio-cells = <2>;
			samsung,npins = <4>;
			status = "okay";
		};

		regulators {
			s_b1_reg: BUCK1 {
				regulator-name = "vdd_npu";
				regulator-min-microvolt = <400000>;
				regulator-max-microvolt = <1300000>;
				regulator-always-on;
				regulator-ramp-delay = <6000>;
				regulator-initial-mode = <1>;                   /* V_PWREN_NPU */
			};

			s_b2_reg: BUCK2 {
				regulator-name = "vdd_cpucl0";
				regulator-min-microvolt = <400000>;
				regulator-max-microvolt = <1300000>;
				regulator-always-on;
				regulator-ramp-delay = <6000>;
				regulator-initial-mode = <1>;                   /* V_PWREN_CPUCL0 */
			};

			s_b3_reg: BUCK3 {
				regulator-name = "vdd_cpucl1";
				regulator-min-microvolt = <400000>;
				regulator-max-microvolt = <1300000>;
				regulator-always-on;
				regulator-ramp-delay = <6000>;
				regulator-initial-mode = <1>;                   /* V_PWREN_CPUCL1 */
			};
/*
			s_b4_reg: BUCK4 {
				regulator-name = "vdd_gnss";
				regulator-min-microvolt = <400000>;
				regulator-max-microvolt = <1300000>;
				regulator-always-on;
				regulator-ramp-delay = <6000>;
				regulator-initial-mode = <3>;
			};

*/
			s_b5_reg: BUCK5 {
				regulator-name = "vdd_mif";
				regulator-min-microvolt = <400000>;
				regulator-max-microvolt = <1300000>;
				regulator-always-on;
				regulator-ramp-delay = <6000>;
				regulator-initial-mode = <1>;                   /* V_PWREN_MIF */
			};

			s_b6_reg: BUCK6 {
				regulator-name = "vdd_cam";
				regulator-min-microvolt = <400000>;
				regulator-max-microvolt = <1300000>;
				regulator-always-on;
				regulator-ramp-delay = <6000>;
				regulator-initial-mode = <1>;                   /* V_PWREN_CAM */
			};

			s_b7_reg: BUCK7 {
				regulator-name = "vdd_lldo1s";
				regulator-min-microvolt = <400000>;
